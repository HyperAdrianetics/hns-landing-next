# Webhook de N8N que recibe el formulario de contacto.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Token del origin trial de Chrome para HTML-in-Canvas.
# Se registra en https://developer.chrome.com/origintrials para un origen exacto
# (https://hypernetics.com.mx no cubre www., ni los preview de Vercel, ni
# localhost: cada origen necesita su propio token).
# Sin él la web funciona igual; solo se apaga el modo nativo de los efectos.
ORIGIN_TRIAL_TOKEN=
